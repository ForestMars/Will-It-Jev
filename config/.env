# Point Rust tracer to local OTel Collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="will-it-jev-router"

# Upstream Provider Configuration
FALLBACK_PROVIDER_TYPE=openai_compatible
FALLBACK_PROVIDER_BASE_URL=http://localhost:11434/v1
FALLBACK_PROVIDER_MODEL=qwen2.5-coder:latest  # or your targeted Ollama model tag
FALLBACK_PROVIDER_API_KEY=ollama             # dummy key (Ollama ignores authentication)






