+// src/tagging.rs
+//
+// Post-routing task tagging, entirely off the request path.
+//
+// The handler calls TagQueue::enqueue() once the routing decision is made (and, if the
+// tagger should see the answer, once the downstream response is in hand). enqueue()
+// never blocks and never fails the request: when the queue is full it bumps a counter
+// and drops the job.
+//
+// A background pipeline invokes the task classifier, a separate model from the router
+// tiers, and appends one JSON line per request to a JSONL file. Records join to
+// logs/routing_capture.jsonl on request_id.
+//
+// TagInput carries the prompt and, optionally, the response. The routing decision is
+// not part of it, so the tagger's labels are independent of router behavior and
+// P(jev | category) measures the category rather than the router.
+
+#![allow(dead_code)] // remove once main.rs and service.rs consume this module
+
+use std::future::Future;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use tokio::fs::OpenOptions;
+use tokio::io::AsyncWriteExt;
+use tokio::sync::{mpsc, Semaphore};
+use tokio::task::JoinHandle;
+use tracing::warn;
+
+// ---------------------------------------------------------------------------
+// Schema
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct TokenUsage {
+    pub input_tokens: u64,
+    pub output_tokens: u64,
+    /// True when counts come from a local tokenizer because the provider reported none.
+    #[serde(default)]
+    pub estimated: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct CategoryScore {
+    pub category_id: String,
+    pub score: f32,
+}
+
+/// Why no verdict exists for a request.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum UntaggedReason {
+    /// The tagger exceeded its call timeout.
+    Timeout,
+    /// The tagger failed.
+    Error,
+    /// The job aged out in the queue and was shed without calling the tagger.
+    Dropped,
+    /// Excluded by sampling; kept as a record so rates have a denominator.
+    SampledOut,
+}
+
+/// The tagger returns Tagged or NoMatch. The pipeline owns Untagged.
+///
+/// no_match: the model ran and found nothing in the taxonomy (signal for growing it).
+/// untagged: no verdict exists (noise, broken down by reason).
+/// The two never share a value, so the no-match rate measures taxonomy coverage only.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "status", rename_all = "snake_case")]
+pub enum TagResult {
+    Tagged {
+        primary: CategoryScore,
+        #[serde(default)]
+        alternatives: Vec<CategoryScore>,
+    },
+    NoMatch {
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        nearest: Option<CategoryScore>,
+    },
+    Untagged {
+        reason: UntaggedReason,
+    },
+}
+
+impl TagResult {
+    pub fn untagged(reason: UntaggedReason) -> Self {
+        TagResult::Untagged { reason }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct TagRecord {
+    pub request_id: String,
+    pub timestamp: DateTime<Utc>,
+    pub taxonomy_version: String,
+    pub tagger_model: String,
+    pub tagger_version: String,
+    /// Time from dequeue to verdict.
+    pub latency_ms: f64,
+    /// Time the job waited in the queue.
+    pub queue_wait_ms: f64,
+    pub result: TagResult,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub usage: Option<TokenUsage>,
+}
+
+// ---------------------------------------------------------------------------
+// Tagger contract
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+pub struct TagInput {
+    pub request_id: String,
+    pub prompt: String,
+    /// Downstream response text, when the tagger should see the exchange.
+    pub response: Option<String>,
+}
+
+#[derive(Debug)]
+pub enum TagError {
+    Timeout,
+    Failed(String),
+}
+
+pub struct TaggerOutput {
+    pub result: TagResult,
+    pub usage: Option<TokenUsage>,
+}
+
+pub trait Tagger: Send + Sync + 'static {
+    fn model(&self) -> &str;
+    fn version(&self) -> &str;
+    fn taxonomy_version(&self) -> &str;
+    fn tag(
+        &self,
+        input: &TagInput,
+    ) -> impl Future<Output = Result<TaggerOutput, TagError>> + Send;
+}
+
+// ---------------------------------------------------------------------------
+// Queue
+// ---------------------------------------------------------------------------
+
+struct TagJob {
+    input: TagInput,
+    enqueued_at: Instant,
+}
+
+#[derive(Clone)]
+pub struct TagQueue {
+    tx: mpsc::Sender<TagJob>,
+    dropped: Arc<AtomicU64>,
+}
+
+impl TagQueue {
+    /// Never blocks. A full or closed queue drops the job and counts it. Queue-full
+    /// drops leave no record (there is no capacity to write one); the counter is the
+    /// only trace, so export it as a metric.
+    pub fn enqueue(&self, input: TagInput) {
+        let job = TagJob {
+            input,
+            enqueued_at: Instant::now(),
+        };
+        if self.tx.try_send(job).is_err() {
+            let n = self.dropped.fetch_add(1, Ordering::Relaxed) + 1;
+            if n.is_power_of_two() {
+                warn!(dropped_tag_jobs = n, "tag queue unavailable; dropping job");
+            }
+        }
+    }
+
+    pub fn dropped(&self) -> u64 {
+        self.dropped.load(Ordering::Relaxed)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Pipeline
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+pub struct TagConfig {
+    pub path: PathBuf,
+    pub queue_capacity: usize,
+    /// Maximum tagger calls in flight.
+    pub concurrency: usize,
+    pub call_timeout: Duration,
+    /// Jobs older than this at dequeue are shed with an Untagged(Dropped) record.
+    pub max_age: Duration,
+    /// Fraction of requests tagged. 1.0 tags everything.
+    pub sample_prob: f32,
+}
+
+impl Default for TagConfig {
+    fn default() -> Self {
+        Self {
+            path: PathBuf::from("logs/task_tags.jsonl"),
+            queue_capacity: 1024,
+            concurrency: 4,
+            call_timeout: Duration::from_secs(5),
+            max_age: Duration::from_secs(60),
+            sample_prob: 1.0,
+        }
+    }
+}
+
+const TWO_POW_64: f64 = 18_446_744_073_709_551_616.0;
+
+/// Deterministic per request id, so reruns and replays sample the same requests.
+pub fn is_sampled(request_id: &str, prob: f32) -> bool {
+    if prob >= 1.0 {
+        return true;
+    }
+    if prob <= 0.0 {
+        return false;
+    }
+    let digest = Sha256::digest(request_id.as_bytes());
+    let mut bytes = [0u8; 8];
+    bytes.copy_from_slice(&digest[..8]);
+    (u64::from_be_bytes(bytes) as f64 / TWO_POW_64) < f64::from(prob)
+}
+
+async fn process<T: Tagger>(tagger: &T, cfg: &TagConfig, job: TagJob) -> TagRecord {
+    let queue_wait = job.enqueued_at.elapsed();
+    let timestamp = Utc::now();
+    let started = Instant::now();
+
+    let (result, usage) = if !is_sampled(&job.input.request_id, cfg.sample_prob) {
+        (TagResult::untagged(UntaggedReason::SampledOut), None)
+    } else if queue_wait > cfg.max_age {
+        (TagResult::untagged(UntaggedReason::Dropped), None)
+    } else {
+        match tokio::time::timeout(cfg.call_timeout, tagger.tag(&job.input)).await {
+            Err(_) | Ok(Err(TagError::Timeout)) => {
+                (TagResult::untagged(UntaggedReason::Timeout), None)
+            }
+            Ok(Err(TagError::Failed(error))) => {
+                warn!(request_id = %job.input.request_id, error = %error, "task tagger failed");
+                (TagResult::untagged(UntaggedReason::Error), None)
+            }
+            Ok(Ok(output)) => (output.result, output.usage),
+        }
+    };
+
+    TagRecord {
+        request_id: job.input.request_id,
+        timestamp,
+        taxonomy_version: tagger.taxonomy_version().to_string(),
+        tagger_model: tagger.model().to_string(),
+        tagger_version: tagger.version().to_string(),
+        latency_ms: started.elapsed().as_secs_f64() * 1000.0,
+        queue_wait_ms: queue_wait.as_secs_f64() * 1000.0,
+        result,
+        usage,
+    }
+}
+
+/// Starts the pipeline. Drop every clone of the returned TagQueue to drain in-flight
+/// jobs and finish; the JoinHandle resolves once the last record is flushed.
+pub fn spawn<T: Tagger>(
+    tagger: Arc<T>,
+    cfg: TagConfig,
+) -> (TagQueue, JoinHandle<std::io::Result<()>>) {
+    let capacity = cfg.queue_capacity.max(1);
+    let concurrency = cfg.concurrency.max(1);
+    let cfg = Arc::new(cfg);
+
+    let (job_tx, mut job_rx) = mpsc::channel::<TagJob>(capacity);
+    let (rec_tx, mut rec_rx) = mpsc::channel::<TagRecord>(capacity);
+    let queue = TagQueue {
+        tx: job_tx,
+        dropped: Arc::new(AtomicU64::new(0)),
+    };
+
+    let writer_path = cfg.path.clone();
+    let writer = tokio::spawn(async move {
+        if let Some(parent) = writer_path.parent() {
+            tokio::fs::create_dir_all(parent).await?;
+        }
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(&writer_path)
+            .await?;
+        let mut flush = tokio::time::interval(Duration::from_secs(1));
+        loop {
+            tokio::select! {
+                record = rec_rx.recv() => {
+                    let Some(record) = record else { break };
+                    let mut line = serde_json::to_string(&record)?;
+                    line.push('\n');
+                    file.write_all(line.as_bytes()).await?;
+                }
+                _ = flush.tick() => {
+                    file.flush().await?;
+                }
+            }
+        }
+        file.flush().await
+    });
+
+    let semaphore = Arc::new(Semaphore::new(concurrency));
+    let dispatcher = tokio::spawn(async move {
+        while let Some(job) = job_rx.recv().await {
+            let permit = Arc::clone(&semaphore)
+                .acquire_owned()
+                .await
+                .expect("semaphore is never closed");
+            let tagger = Arc::clone(&tagger);
+            let cfg = Arc::clone(&cfg);
+            let rec_tx = rec_tx.clone();
+            tokio::spawn(async move {
+                let record = process(tagger.as_ref(), &cfg, job).await;
+                if rec_tx.send(record).await.is_err() {
+                    warn!("task tag writer is unavailable");
+                }
+                drop(permit);
+            });
+        }
+        // Every sender is gone: wait for in-flight jobs, then release the writer.
+        let _ = semaphore.acquire_many(concurrency as u32).await;
+    });
+
+    let handle = tokio::spawn(async move {
+        let _ = dispatcher.await;
+        writer.await.map_err(std::io::Error::other)?
+    });
+
+    (queue, handle)
+}
+
+// ---------------------------------------------------------------------------
+// Tests
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct Fixed {
+        delay: Duration,
+        result: TagResult,
+    }
+
+    impl Tagger for Fixed {
+        fn model(&self) -> &str {
+            "fake-tagger"
+        }
+        fn version(&self) -> &str {
+            "t0"
+        }
+        fn taxonomy_version(&self) -> &str {
+            "tax-1"
+        }
+        fn tag(
+            &self,
+            _input: &TagInput,
+        ) -> impl Future<Output = Result<TaggerOutput, TagError>> + Send {
+            let delay = self.delay;
+            let result = self.result.clone();
+            async move {
+                tokio::time::sleep(delay).await;
+                Ok(TaggerOutput {
+                    result,
+                    usage: Some(TokenUsage {
+                        input_tokens: 10,
+                        output_tokens: 2,
+                        estimated: false,
+                    }),
+                })
+            }
+        }
+    }
+
+    fn tagged() -> TagResult {
+        TagResult::Tagged {
+            primary: CategoryScore {
+                category_id: "c7".into(),
+                score: 0.9,
+            },
+            alternatives: vec![],
+        }
+    }
+
+    fn input(id: &str) -> TagInput {
+        TagInput {
+            request_id: id.into(),
+            prompt: "p".into(),
+            response: None,
+        }
+    }
+
+    fn temp_path(name: &str) -> PathBuf {
+        let path = std::env::temp_dir().join(format!("tagging-{}-{name}.jsonl", std::process::id()));
+        let _ = std::fs::remove_file(&path);
+        path
+    }
+
+    fn cfg(path: PathBuf) -> TagConfig {
+        TagConfig {
+            path,
+            ..TagConfig::default()
+        }
+    }
+
+    fn read_records(path: &PathBuf) -> Vec<TagRecord> {
+        std::fs::read_to_string(path)
+            .unwrap()
+            .lines()
+            .map(|line| serde_json::from_str(line).unwrap())
+            .collect()
+    }
+
+    fn by_id<'a>(records: &'a [TagRecord], id: &str) -> &'a TagRecord {
+        records.iter().find(|r| r.request_id == id).unwrap()
+    }
+
+    #[test]
+    fn no_match_and_untagged_serialize_distinctly() {
+        let no_match = serde_json::to_string(&TagResult::NoMatch { nearest: None }).unwrap();
+        let untagged = serde_json::to_string(&TagResult::untagged(UntaggedReason::Timeout)).unwrap();
+        assert_eq!(no_match, r#"{"status":"no_match"}"#);
+        assert_eq!(untagged, r#"{"status":"untagged","reason":"timeout"}"#);
+        let back: TagResult = serde_json::from_str(&untagged).unwrap();
+        assert_eq!(back, TagResult::untagged(UntaggedReason::Timeout));
+    }
+
+    #[test]
+    fn sampling_is_deterministic_and_respects_extremes() {
+        assert!(is_sampled("x", 1.0));
+        assert!(!is_sampled("x", 0.0));
+        assert_eq!(is_sampled("req-1", 0.5), is_sampled("req-1", 0.5));
+        let hits = (0..2000)
+            .filter(|i| is_sampled(&format!("req-{i}"), 0.5))
+            .count();
+        assert!((800..1200).contains(&hits), "hits={hits}");
+    }
+
+    #[tokio::test]
+    async fn pipeline_writes_one_record_per_job() {
+        let path = temp_path("basic");
+        let tagger = Arc::new(Fixed {
+            delay: Duration::ZERO,
+            result: tagged(),
+        });
+        let (queue, handle) = spawn(tagger, cfg(path.clone()));
+        for i in 0..3 {
+            queue.enqueue(input(&format!("r{i}")));
+        }
+        drop(queue);
+        handle.await.unwrap().unwrap();
+
+        let records = read_records(&path);
+        assert_eq!(records.len(), 3);
+        assert!(records.iter().all(|r| {
+            matches!(r.result, TagResult::Tagged { .. })
+                && r.usage.is_some()
+                && r.taxonomy_version == "tax-1"
+                && r.tagger_model == "fake-tagger"
+        }));
+    }
+
+    #[tokio::test]
+    async fn slow_tagger_yields_untagged_timeout() {
+        let path = temp_path("timeout");
+        let tagger = Arc::new(Fixed {
+            delay: Duration::from_millis(300),
+            result: tagged(),
+        });
+        let config = TagConfig {
+            call_timeout: Duration::from_millis(20),
+            ..cfg(path.clone())
+        };
+        let (queue, handle) = spawn(tagger, config);
+        queue.enqueue(input("slow"));
+        drop(queue);
+        handle.await.unwrap().unwrap();
+
+        let records = read_records(&path);
+        assert_eq!(records[0].result, TagResult::untagged(UntaggedReason::Timeout));
+        assert!(records[0].usage.is_none());
+    }
+
+    #[tokio::test]
+    async fn stale_jobs_are_shed_with_a_record() {
+        let path = temp_path("stale");
+        let tagger = Arc::new(Fixed {
+            delay: Duration::from_millis(100),
+            result: tagged(),
+        });
+        let config = TagConfig {
+            concurrency: 1,
+            max_age: Duration::from_millis(10),
+            ..cfg(path.clone())
+        };
+        let (queue, handle) = spawn(tagger, config);
+        queue.enqueue(input("first"));
+        queue.enqueue(input("second"));
+        drop(queue);
+        handle.await.unwrap().unwrap();
+
+        let records = read_records(&path);
+        assert_eq!(records.len(), 2);
+        assert!(matches!(by_id(&records, "first").result, TagResult::Tagged { .. }));
+        assert_eq!(
+            by_id(&records, "second").result,
+            TagResult::untagged(UntaggedReason::Dropped)
+        );
+        assert!(by_id(&records, "second").queue_wait_ms >= 10.0);
+    }
+
+    #[tokio::test]
+    async fn sampled_out_jobs_still_produce_a_record() {
+        let path = temp_path("sampled");
+        let tagger = Arc::new(Fixed {
+            delay: Duration::ZERO,
+            result: tagged(),
+        });
+        let config = TagConfig {
+            sample_prob: 0.0,
+            ..cfg(path.clone())
+        };
+        let (queue, handle) = spawn(tagger, config);
+        queue.enqueue(input("s1"));
+        drop(queue);
+        handle.await.unwrap().unwrap();
+
+        let records = read_records(&path);
+        assert_eq!(records[0].result, TagResult::untagged(UntaggedReason::SampledOut));
+    }
+
+    #[tokio::test]
+    async fn full_queue_counts_drops_without_blocking() {
+        let path = temp_path("full");
+        let tagger = Arc::new(Fixed {
+            delay: Duration::from_millis(50),
+            result: tagged(),
+        });
+        let config = TagConfig {
+            queue_capacity: 1,
+            concurrency: 1,
+            ..cfg(path.clone())
+        };
+        let (queue, handle) = spawn(tagger, config);
+        // current_thread runtime: nothing drains until the first await, so one job
+        // fits and the other 19 are dropped, all without yielding.
+        for i in 0..20 {
+            queue.enqueue(input(&format!("r{i}")));
+        }
+        assert_eq!(queue.dropped(), 19);
+        drop(queue);
+        handle.await.unwrap().unwrap();
+        assert_eq!(read_records(&path).len(), 1);
+    }
+}
